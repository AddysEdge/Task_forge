# Copy to .env and adjust for local runs. Never commit a real .env.

# Role of the process: api | worker | all
APP_ROLE=all

# Unique per worker process. Leave blank to auto-generate <hostname>-<random>.
WORKER_ID=

# PostgreSQL (authoritative job store)
DATABASE_URL=jdbc:postgresql://localhost:5432/taskforge
DATABASE_USERNAME=taskforge
DATABASE_PASSWORD=taskforge

# Redis (cache + worker heartbeats, non-authoritative)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Worker tuning
WORKER_THREAD_COUNT=4
WORKER_QUEUE_CAPACITY=100

SERVER_PORT=8080
